# Copia este archivo a .env y rellena los valores para desarrollo local.
# En Render, configura estas mismas variables en el dashboard del servicio (no subas .env nunca).

# Contraseña para acceder a la app. Si se deja vacía, el login queda desactivado.
APP_PASSWORD=

# Clave para firmar la cookie de sesión de Flask. Usa un valor largo y aleatorio.
SECRET_KEY=

# Cadena de conexión a Postgres (Neon, Supabase, etc.), p. ej.:
# postgresql://usuario:contraseña@host/basededatos
DATABASE_URL=
